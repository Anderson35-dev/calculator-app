int Quotient(int number1, int number2){
    return number1 / number2;
}
int Modulus(int number1, int number2){
    return number1 % number2;
}
int Factorial(int number1) {
    int result = 1;
        for (int i = 1; i <= number1; i++) {
            result = result * i;
    }
        return result;
}

int RaiseToPower( int number1,int number2){
    int result = 1;
    int i;
     for (i = 0; i< number2; i++){
       result = result * number1;
    }
     return result;
}

double add( double number1,double number2){
    double result = number1 + number2;
    return result;
}
double multiply( double number1,double number2){
    double result = number1 * number2;
    return result;
}
double sub( double  number1,double  number2){
    double result = number1 - number2;
    return result;
}
double divide( double number1,double number2){
    double result = number1 / number2;
    return result;
}


int String_to_int_reversed(char str[], int string_size, bool is_negative){
    int result = 0;
    int i = string_size - 1;

    while (i >= 0) {
        result = result * 10 + (str[i] - '0');
        i--;
    }
    if(is_negative == true){
        return result * -1;
    }else{
        return result;
    }
}

bool is_it_operator(char character){
    if(character == '+' || character == '-' || character == '/' || character == '*'){
        return true;
    }
    else return false;
}
  int extract_subexpression (char exp[], int sizeofexp, char sub_exp[], int size_of_exp, int index_of_operator){
    int k = index_of_operator - 1;
    while (k >= 0 && !is_it_operator(exp[k])) k--;
    int start_length = k + 1;
    if(k == 0 && exp[k] == '-'){
        start_length--;
    }

    int m = index_of_operator + 1;
    int start = m;
    while (m < sizeofexp){
        if(m != start && is_it_operator(exp[m])){
            break;
        }
        m++;
    }
    int end_length = m;

    int j = 0;
    for (int i = start_length; i < end_length; i++) {
        sub_exp[j] = exp[i];
        j++;
    }
    sub_exp[j] = '\0';

    return start_length;
}

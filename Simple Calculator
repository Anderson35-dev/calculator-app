}
int find(char char_array[], int size_of_array, int starting_position, char character_to_find){
    for (int i = starting_position; i < size_of_array && char_array[i] != '\0'; i++){
        if (char_array[i] == character_to_find ){
            return i;
        }
    }
    return -1;
}
double calculateString(char expression[]) {
    process_operator(expression, '/');
    process_operator(expression, '*');
    process_operator(expression, '+');
    process_operator(expression, '-');
    return atof(expression);
}



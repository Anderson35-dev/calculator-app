int String_to_int_reversed(char str[], int string_size, bool is_negative){
    int result = 0;
    int i = string_size - 1;

    while (i >= 0) {
        result = result * 10 + (str[i] - '0');
        i--;
    }
    if(is_negative == true){
        return result * -1;
    }else{
        return result;
    }
}

bool is_it_operator(char character){
    if(character == '+' || character == '-' || character == '/' || character == '*'){
        return true;
    }
    else return false;
}
  int extract_subexpression (char exp[], int sizeofexp, char sub_exp[], int size_of_exp, int index_of_operator){
    int k = index_of_operator - 1;
    while (k >= 0 && !is_it_operator(exp[k])) k--;
    int start_length = k + 1;
    if(k == 0 && exp[k] == '-'){
        start_length--;
    }

    int m = index_of_operator + 1;
    int start = m;
    while (m < sizeofexp){
        if(m != start && is_it_operator(exp[m])){
            break;
        }
        m++;
    }
    int end_length = m;

    int j = 0;
    for (int i = start_length; i < end_length; i++) {
        sub_exp[j] = exp[i];
        j++;
    }
    sub_exp[j] = '\0';

    return start_length;
}
double Subcalculator(char expression[],int length, int index_of_op){

}
int int_to_string(int number, char str[], int buffer_size){
     return snprintf(str, buffer_size, "%d", number);
}
void replace_expression_with_result(char exp[], int sizeofexp, char subexp[], int sizeofsub, int start_position_of_sub_exp, char result[], int size_of_result){
    char buffer[100];
    strncpy(buffer, exp, start_position_of_sub_exp);
    buffer[start_position_of_sub_exp] = '\0';
    strcat(buffer, result);
    int current_length_of_buffer = strlen(buffer);
    int remainder_exp_index = start_position_of_sub_exp + sizeofsub;
    strcpy(buffer + current_length_of_buffer, exp + remainder_exp_index);
    strcpy(exp, buffer);
}
void process_operator(char number[], char operation){
    char sub_exp[20];
    char result_string[20];
    double result;

    for(int i = 0; i < strlen(number); i++){
        if(number[i] == operation){
                result = Subcalculator(number, strlen(number), i);
                int_to_string(result, result_string, sizeof(result_string));
                int start_pos = extract_subexpression(number,strlen(number),sub_exp,sizeof(sub_exp),i);
                replace_expression_with_result(number,strlen(number),sub_exp,strlen(sub_exp),start_pos,result_string,10);
                printf("Result: %.2f\n", result);
                i = 0;
        }
    }
}



int main(){
    char number[] = "3*-2";

